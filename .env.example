# ============================================================================
# PORTFOLIO ENVIRONMENT VARIABLES (SECRET HYGIENE SPECIFICATION)
# ============================================================================
# NOTE: Prefix ONLY public browser variables with NEXT_PUBLIC_.
# ALL secret API keys, tokens, and backend credentials MUST omit the prefix!

# ----------------------------------------------------------------------------
# 1. PUBLIC CLIENT VARIABLES (Exposed to Browser Bundle)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAXxxxxxxxxx # Cloudflare Turnstile Site Key (Public)

# ----------------------------------------------------------------------------
# 2. PRIVATE SERVER SECRETS (NEVER exposed to Client/Browser)
# ----------------------------------------------------------------------------
# Cloudflare Turnstile Server Verification Secret
TURNSTILE_SECRET_KEY=0x4AAAAAAAXxxxxxxxxx_SecretKey

# Email Delivery Service (Resend / SendGrid / Nodemailer)
RESEND_API_KEY=re_123456789_SecretKey
CONTACT_TO_EMAIL=your-personal-email@domain.com
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Upstash Redis Rate Limiting (Optional - Fallback to in-memory if omitted)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxx_SecretToken
